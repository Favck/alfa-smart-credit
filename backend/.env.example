# Локально Django читает backend/.env; окружение процесса имеет приоритет.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECRET_KEY=replace-before-external-deployment
DEMO_MODE=true
ML_BASE_URL=http://127.0.0.1:8001
ML_TIMEOUT_SECONDS=2.5
LLM_BASE_URL=
LLM_API_KEY=dummy
LLM_MODEL_NAME=qwen2.5:7b
LLM_TIMEOUT_SECONDS=5.0
DATABASE_ENGINE=sqlite
# Docker uses DATABASE_ENGINE=postgresql and the private db service.
POSTGRES_DB=alfa
POSTGRES_USER=alfa
POSTGRES_PASSWORD=change-for-production
POSTGRES_HOST=db
POSTGRES_PORT=5432
