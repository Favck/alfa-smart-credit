      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);const d=pm.response.json().find(d=>d.kind==='contract');if(d)pm.collectionVariables.set('documentId',d.id);"
            ]
          }
        }
      ]
    },
