      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const a=pm.response.json();if(a.current_offer)pm.collectionVariables.set('offerId',a.current_offer.id);if(a.info_request)pm.collectionVariables.set('infoRequestId',a.info_request.id);"
            ]
          }
        }
      ]
    },
