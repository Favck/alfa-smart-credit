          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const a=pm.response.json(); if(a.current_offer)pm.collectionVariables.set('offerId',a.current_offer.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Карточка / сохранённый статус",
