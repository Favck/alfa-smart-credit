{
  "info": {
    "name": "ITigers · Альфа.Поток",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Два отдельных сценария: 01–14 для green; для дозапроса повторить 02 с profile=yellow, создать заявку (07), отправить (08), затем 15–22, 09, 11–14. Шаг 02b берёт параметры текущей компании автоматически. 23/24/25 — альтернативные действия, не запускать все подряд на завершённой заявке. Загрузка файла выбирается вручную в Postman. Все операции синтетические."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://alpha.srv-node.com/api/v1"
    },
    {
      "key": "profile",
      "value": "green"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bankToken",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    },
    {
      "key": "offerId",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "infoRequestId",
      "value": ""
    },
    {
      "key": "attachmentId",
      "value": ""
    },
    {
      "key": "revenue",
      "value": "1500000"
    },
    {
      "key": "payments",
      "value": "40000"
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health",
            ""
          ]
        }
      }
    },
    {
      "name": "02 Войти клиентом green (yellow для ручной ветки)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/demo-login/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "demo-login",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"profile_id\": \"{{profile}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.collectionVariables.set('token',pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02b Данные компании для параметров клиента",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token}}"
          }
        ],
        "url": "{{baseUrl}}/company/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const c=pm.response.json();pm.collectionVariables.set('revenue',c.monthly_revenue);pm.collectionVariables.set('payments',c.current_monthly_payments);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Продукты",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            ""
          ]
        }
      }
    },
    {
      "name": "04 Персональные статьи",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/news/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "news",
            ""
          ]
        }
      }
    },
    {
      "name": "05 Полный материал",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/news/1/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "news",
            "1",
            ""
          ]
        }
      }
    },
    {
      "name": "06 Предварительная оценка",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/scoring/pre-predict/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "scoring",
            "pre-predict",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": \"working_capital\",\n  \"amount\": 2000000,\n  \"term_months\": 24,\n  \"purpose\": \"ITigers: проверка сквозного пути\",\n  \"monthly_revenue\": {{revenue}},\n  \"current_monthly_payments\": {{payments}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 Сохранить черновик",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/applications/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "applications",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": \"working_capital\",\n  \"amount\": 2000000,\n  \"term_months\": 24,\n  \"purpose\": \"ITigers: проверка сквозного пути\",\n  \"monthly_revenue\": {{revenue}},\n  \"current_monthly_payments\": {{payments}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);",
              "pm.collectionVariables.set('applicationId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Отправить",
